{
  "name": "QuickStark app",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postAttachCommand": {
    "app": "npx --yes serve -l 3000 ."
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "index.html"
      ]
    },
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
